# ============================================================================
# HORIZON ESTATES — GOHIGHLEVEL API v2, DUAL VOICE AI & HITL CONCIERGE DEMO
# ============================================================================

APP_ENV=development
APP_PORT=8090
SQLITE_DB_PATH=./data/horizon_demo.db
DEMO_ACCESS_PIN=

# --- Strategy Selectors ---
# Voice strategy: "gemini_live" (zero phone exposure, browser voice + webhooks) | "retell"
VOICE_PROVIDER=gemini_live
# CRM strategy: "dual_ghl" (SQLite WAL local ledger + GoHighLevel API v2) | "local_only"
CRM_PROVIDER=dual_ghl

# --- Legal Compliance (California Penal Code § 632 Two-Party Recording Notice) ---
CALIFORNIA_TWO_PARTY_CONSENT=true

# --- Gemini Multimodal Live / Vertex AI Grounded Function Calling ---
GEMINI_API_KEY=
VERTEX_USE_ADC=true
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview-04-09

# --- Optional OpenRouter Fallback for Text Concierge ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- GoHighLevel Developer Sandbox / OAuth App (API v2) ---
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Paste Private Integration Token (PIT) from GHL Sub-Account OR authorize via OAuth 2.0:
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
# Optional GHL Pipeline & Stage IDs (if omitted, Contacts + Notes + Tags still sync 100% live)
GHL_PIPELINE_ID=
GHL_STAGE_NEW_ID=
GHL_STAGE_QUALIFIED_ID=
GHL_STAGE_HITL_ID=
GHL_STAGE_BOOKED_ID=
# Optional Marketplace OAuth 2.0 App credentials (for 1-click sub-account install flow)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:8090/api/v1/ghl/oauth/callback

# --- Optional Retell AI Adapter (Secondary PSTN / Web Call Strategy) ---
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=
# Leave blank if you do NOT want to display any PSTN phone number on the demo UI:
RETELL_PUBLIC_PHONE=
